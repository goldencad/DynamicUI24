<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DynamicUI24.Avalonia.Presentation.ShellHost">
  <Border Background="{DynamicResource DuiSurfaceBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <Border Padding="18,12"
              Background="{DynamicResource DuiSurfaceRaisedBrush}"
              BorderBrush="{DynamicResource DuiBorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
          <Button x:Name="ApplicationMenuButton" Width="44" Height="38" Padding="5"
                  Click="ApplicationMenuClicked">
            <PathIcon x:Name="LogoIcon" Width="20" Height="20"
                      Foreground="{DynamicResource DuiAccentBrush}" />
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ApplicationNameText" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource DuiTextBrush}" />
            <TextBlock x:Name="WorkspaceTitleText" FontSize="12"
                       Foreground="{DynamicResource DuiTextMutedBrush}" />
          </StackPanel>
          <Button Grid.Column="2" x:Name="SearchButton" Click="SearchClicked" MinWidth="126"
                  AutomationProperties.Name="Search commands and destinations">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⌕" x:Name="SearchIconLabel" />
              <TextBlock Text="Search…" x:Name="SearchButtonLabel" />
              <TextBlock Text="⌘K" x:Name="SearchShortcutLabel" Opacity="0.7" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" x:Name="ExitButton" Click="ExitClicked" />
        </Grid>
      </Border>
      <ContentControl Grid.Row="1" x:Name="RibbonPresenter" />
      <ContentControl Grid.Row="2" x:Name="NotificationPresenter" />
      <Grid Grid.Row="3" x:Name="ShellRegions" ColumnDefinitions="260,5,*,0,0">
        <Border Grid.Column="0" Background="{DynamicResource DuiSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource DuiBorderBrush}" BorderThickness="0,0,1,0">
          <ContentControl x:Name="NavigationPresenter" />
        </Border>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource DuiBorderBrush}" />
        <Grid Grid.Column="2" RowDefinitions="Auto,*" MinWidth="420">
          <ContentControl x:Name="BreadcrumbPresenter" Margin="18,10,18,0" />
          <ContentControl Grid.Row="1" x:Name="WorkspacePresenter" Margin="18" />
        </Grid>
        <GridSplitter Grid.Column="3" x:Name="ContextSplitter" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" Background="{DynamicResource DuiBorderBrush}"
                      IsVisible="False" />
        <Border Grid.Column="4" x:Name="ContextRegion" IsVisible="False"
                Background="{DynamicResource DuiSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource DuiBorderBrush}" BorderThickness="1,0,0,0">
          <ContentControl x:Name="ContextPresenter" />
        </Border>
      </Grid>
      <Border Grid.Row="3" x:Name="ApplicationMenuOverlay" IsVisible="False"
              Background="{DynamicResource DuiSurfaceBrush}"
              BorderBrush="{DynamicResource DuiBorderBrush}" BorderThickness="0,0,0,1">
        <ContentControl x:Name="ApplicationMenuPresenter" />
      </Border>
      <Border Grid.Row="0" Grid.RowSpan="4" x:Name="SearchOverlay" IsVisible="False"
              Background="{DynamicResource DuiOverlayBackdropBrush}" PointerPressed="SearchBackdropPressed">
        <ContentControl x:Name="SearchPresenter" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="24,72,24,24" PointerPressed="SearchContentPressed" />
      </Border>
      <Border Grid.Row="4" Padding="18,8"
              Background="{DynamicResource DuiSurfaceRaisedBrush}"
              BorderBrush="{DynamicResource DuiBorderBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource DuiTextMutedBrush}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
