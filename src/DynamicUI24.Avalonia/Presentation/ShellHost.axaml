<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DynamicUI24.Avalonia.Presentation.ShellHost">
  <Border Background="{DynamicResource DuiSurfaceWindowBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <Border Padding="{DynamicResource DuiShellHeaderPadding}"
              Background="{DynamicResource DuiSurfacePanelBrush}"
              BorderBrush="{DynamicResource DuiBorderSubtleBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
          <Button x:Name="ApplicationMenuButton" MinWidth="{DynamicResource DuiHitTargetMinimum}"
                  Height="{DynamicResource DuiControlHeightStandard}" Padding="5"
                  Click="ApplicationMenuClicked">
            <PathIcon x:Name="LogoIcon" Width="{DynamicResource DuiIconSizeLarge}"
                      Height="{DynamicResource DuiIconSizeLarge}"
                      Foreground="{DynamicResource DuiAccentPrimaryBrush}" />
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="ApplicationNameText" FontSize="{DynamicResource DuiTypographyTitle}"
                       FontWeight="SemiBold" Foreground="{DynamicResource DuiTextPrimaryBrush}" />
            <TextBlock x:Name="WorkspaceTitleText" FontSize="{DynamicResource DuiTypographyBodySmall}"
                       Foreground="{DynamicResource DuiTextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="2" x:Name="SearchButton" Click="SearchClicked" MinWidth="126"
                  AutomationProperties.Name="Search commands and destinations">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⌕" x:Name="SearchIconLabel" />
              <TextBlock Text="Search…" x:Name="SearchButtonLabel" />
              <TextBlock Text="⌘K" x:Name="SearchShortcutLabel" Opacity="0.7" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" x:Name="ExitButton" Click="ExitClicked" />
        </Grid>
      </Border>
      <ContentControl Grid.Row="1" x:Name="RibbonPresenter" />
      <ContentControl Grid.Row="2" x:Name="NotificationPresenter" />
      <Grid Grid.Row="3" x:Name="ShellRegions" ColumnDefinitions="260,5,*,0,0">
        <Border Grid.Column="0" Background="{DynamicResource DuiSurfacePanelBrush}"
                BorderBrush="{DynamicResource DuiBorderSubtleBrush}" BorderThickness="0,0,1,0">
          <ContentControl x:Name="NavigationPresenter" />
        </Border>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource DuiBorderSubtleBrush}" />
        <Grid Grid.Column="2" RowDefinitions="Auto,*" MinWidth="420">
          <ContentControl x:Name="BreadcrumbPresenter" Margin="16,8,16,0" />
          <ContentControl Grid.Row="1" x:Name="WorkspacePresenter" Margin="{DynamicResource DuiShellRegionPaddingThickness}" />
        </Grid>
        <GridSplitter Grid.Column="3" x:Name="ContextSplitter" ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext" Background="{DynamicResource DuiBorderSubtleBrush}"
                      IsVisible="False" />
        <Border Grid.Column="4" x:Name="ContextRegion" IsVisible="False"
                Background="{DynamicResource DuiSurfacePanelBrush}"
                BorderBrush="{DynamicResource DuiBorderSubtleBrush}" BorderThickness="1,0,0,0">
          <ContentControl x:Name="ContextPresenter" />
        </Border>
      </Grid>
      <Border Grid.Row="3" x:Name="ApplicationMenuOverlay" IsVisible="False"
              Background="{DynamicResource DuiSurfaceBrush}"
              BorderBrush="{DynamicResource DuiBorderSubtleBrush}" BorderThickness="0,0,0,1">
        <ContentControl x:Name="ApplicationMenuPresenter" />
      </Border>
      <Border Grid.Row="0" Grid.RowSpan="4" x:Name="SearchOverlay" IsVisible="False"
              Background="{DynamicResource DuiOverlayBackdropBrush}" PointerPressed="SearchBackdropPressed">
        <ContentControl x:Name="SearchPresenter" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="24,72,24,24" PointerPressed="SearchContentPressed" />
      </Border>
      <Border Grid.Row="4" Padding="{DynamicResource DuiShellStatusPadding}"
              Background="{DynamicResource DuiSurfacePanelBrush}"
              BorderBrush="{DynamicResource DuiBorderSubtleBrush}"
              BorderThickness="0,1,0,0">
        <TextBlock x:Name="StatusText" FontSize="{DynamicResource DuiTypographyBodySmall}"
                   Foreground="{DynamicResource DuiTextSecondaryBrush}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
