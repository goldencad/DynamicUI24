      <SolidColorBrush x:Key="DuiCheckBoxHoverBackgroundBrush" Color="#FFF3F4F6" />
      <SolidColorBrush x:Key="DuiCheckBoxHoverBorderBrush" Color="#FF6B7280" />
      <SolidColorBrush x:Key="DuiCheckBoxCheckedBackgroundBrush" Color="#FF2563EB" />
      <SolidColorBrush x:Key="DuiCheckBoxCheckedBorderBrush" Color="#FF2563EB" />
