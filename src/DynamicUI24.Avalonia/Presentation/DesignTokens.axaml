<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="DuiSpacingXs">4</x:Double>
  <x:Double x:Key="DuiSpacingSmall">8</x:Double>
  <x:Double x:Key="DuiSpacingMedium">12</x:Double>
  <x:Double x:Key="DuiSpacingLarge">16</x:Double>
  <x:Double x:Key="DuiRadiusSmall">4</x:Double>
  <x:Double x:Key="DuiRadiusMedium">7</x:Double>
  <x:Double x:Key="DuiTypographyCaption">11</x:Double>
  <x:Double x:Key="DuiTypographyLabel">13</x:Double>
  <x:Double x:Key="DuiTypographyBody">14</x:Double>
  <x:Double x:Key="DuiTypographyTitle">16</x:Double>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="DuiSurfaceBrush" Color="#FFF8FAFC" />
      <SolidColorBrush x:Key="DuiSurfaceRaisedBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DuiTextBrush" Color="#FF172033" />
      <SolidColorBrush x:Key="DuiTextMutedBrush" Color="#FF667085" />
      <SolidColorBrush x:Key="DuiBorderBrush" Color="#FFD0D5DD" />
      <SolidColorBrush x:Key="DuiAccentBrush" Color="#FF2563EB" />
      <SolidColorBrush x:Key="DuiAccentTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DuiSelectionBrush" Color="#FFDCE8FF" />
      <SolidColorBrush x:Key="DuiHoverBrush" Color="#FFEFF4FA" />
      <SolidColorBrush x:Key="DuiSelectionHoverBrush" Color="#FFC9DCFF" />
      <SolidColorBrush x:Key="DuiFocusBrush" Color="#FF175CD3" />
      <SolidColorBrush x:Key="DuiDisabledSurfaceBrush" Color="#FFF2F4F7" />
      <SolidColorBrush x:Key="DuiDisabledBrush" Color="#FF98A2B3" />
      <SolidColorBrush x:Key="DuiSuccessBrush" Color="#FF16803C" />
      <SolidColorBrush x:Key="DuiWarningBrush" Color="#FFB54708" />
      <SolidColorBrush x:Key="DuiErrorBrush" Color="#FFD92D20" />
      <SolidColorBrush x:Key="DuiInfoBrush" Color="#FF175CD3" />
      <SolidColorBrush x:Key="DuiGridBrush" Color="#FFE4E7EC" />
      <SolidColorBrush x:Key="DuiReadOnlyBrush" Color="#FFF2F4F7" />
      <SolidColorBrush x:Key="DuiCalculatedBrush" Color="#FFF4EBFF" />
      <SolidColorBrush x:Key="Privacy.Mask.Foreground" Color="#FF475467" />
      <SolidColorBrush x:Key="Privacy.Mask.Background" Color="#FFF2F4F7" />
      <SolidColorBrush x:Key="Privacy.Hidden.Foreground" Color="#FF667085" />
      <SolidColorBrush x:Key="Privacy.Icon.Foreground" Color="#FF344054" />
      <SolidColorBrush x:Key="Privacy.Reveal.Focus" Color="#FF175CD3" />
      <SolidColorBrush x:Key="Privacy.Restricted.Indicator" Color="#FFB54708" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="DuiSurfaceBrush" Color="#FF101828" />
      <SolidColorBrush x:Key="DuiSurfaceRaisedBrush" Color="#FF1D2939" />
      <SolidColorBrush x:Key="DuiTextBrush" Color="#FFF2F4F7" />
      <SolidColorBrush x:Key="DuiTextMutedBrush" Color="#FF98A2B3" />
      <SolidColorBrush x:Key="DuiBorderBrush" Color="#FF475467" />
      <SolidColorBrush x:Key="DuiAccentBrush" Color="#FF84ADFF" />
      <SolidColorBrush x:Key="DuiAccentTextBrush" Color="#FF101828" />
      <SolidColorBrush x:Key="DuiSelectionBrush" Color="#FF234478" />
      <SolidColorBrush x:Key="DuiHoverBrush" Color="#FF344054" />
      <SolidColorBrush x:Key="DuiSelectionHoverBrush" Color="#FF305993" />
      <SolidColorBrush x:Key="DuiFocusBrush" Color="#FF84CAFF" />
      <SolidColorBrush x:Key="DuiDisabledSurfaceBrush" Color="#FF202939" />
      <SolidColorBrush x:Key="DuiDisabledBrush" Color="#FF667085" />
      <SolidColorBrush x:Key="DuiSuccessBrush" Color="#FF6CE9A6" />
      <SolidColorBrush x:Key="DuiWarningBrush" Color="#FFFEC84B" />
      <SolidColorBrush x:Key="DuiErrorBrush" Color="#FFFDA29B" />
      <SolidColorBrush x:Key="DuiInfoBrush" Color="#FF84CAFF" />
      <SolidColorBrush x:Key="DuiGridBrush" Color="#FF344054" />
      <SolidColorBrush x:Key="DuiReadOnlyBrush" Color="#FF202939" />
      <SolidColorBrush x:Key="DuiCalculatedBrush" Color="#FF3B2A56" />
      <SolidColorBrush x:Key="Privacy.Mask.Foreground" Color="#FFD0D5DD" />
      <SolidColorBrush x:Key="Privacy.Mask.Background" Color="#FF202939" />
      <SolidColorBrush x:Key="Privacy.Hidden.Foreground" Color="#FF98A2B3" />
      <SolidColorBrush x:Key="Privacy.Icon.Foreground" Color="#FFD0D5DD" />
      <SolidColorBrush x:Key="Privacy.Reveal.Focus" Color="#FF84CAFF" />
      <SolidColorBrush x:Key="Privacy.Restricted.Indicator" Color="#FFFEC84B" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
