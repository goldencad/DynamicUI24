<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DynamicUI24.Avalonia.Presentation">
  <x:Double x:Key="DuiSpacingXs">4</x:Double>
  <x:Double x:Key="DuiSpacingSmall">8</x:Double>
  <x:Double x:Key="DuiSpacingMedium">12</x:Double>
  <x:Double x:Key="DuiSpacingLarge">16</x:Double>
  <x:Double x:Key="DuiRadiusSmall">4</x:Double>
  <x:Double x:Key="DuiRadiusMedium">7</x:Double>
  <x:Double x:Key="DuiTypographyCaption">11</x:Double>
  <x:Double x:Key="DuiTypographyLabel">13</x:Double>
  <x:Double x:Key="DuiTypographyBody">14</x:Double>
  <x:Double x:Key="DuiTypographyTitle">16</x:Double>
  <!-- v0.16 semantic aliases. Physical values remain here in the theme layer. -->
  <x:String x:Key="DuiFontFamilyUi">system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif</x:String>
  <x:String x:Key="DuiFontFamilyCode">ui-monospace, "SFMono-Regular", Consolas, monospace</x:String>
  <x:Double x:Key="DuiSpace2Xs">2</x:Double>
  <x:Double x:Key="DuiSpaceXs">4</x:Double>
  <x:Double x:Key="DuiSpaceS">8</x:Double>
  <x:Double x:Key="DuiSpaceM">12</x:Double>
  <x:Double x:Key="DuiSpaceL">16</x:Double>
  <x:Double x:Key="DuiSpaceXl">24</x:Double>
  <x:Double x:Key="DuiSpace2Xl">32</x:Double>
  <x:Double x:Key="DuiControlHeightCompact">28</x:Double>
  <x:Double x:Key="DuiControlHeightStandard">34</x:Double>
  <x:Double x:Key="DuiControlHeightLarge">40</x:Double>
  <x:Double x:Key="DuiIconSizeSmall">12</x:Double>
  <x:Double x:Key="DuiIconSizeStandard">16</x:Double>
  <x:Double x:Key="DuiIconSizeLarge">20</x:Double>
  <x:Double x:Key="DuiHitTargetMinimum">32</x:Double>
  <x:Double x:Key="DuiFormReadableWidth">760</x:Double>
  <x:Double x:Key="DuiEditorWidthShort">96</x:Double>
  <x:Double x:Key="DuiEditorWidthCompact">220</x:Double>
  <x:Double x:Key="DuiEditorWidthMedium">360</x:Double>
  <x:Double x:Key="DuiEditorWidthLong">560</x:Double>
  <x:Double x:Key="DuiSettingsNavigationWidth">248</x:Double>
  <x:Double x:Key="DuiTypographyPageTitle">24</x:Double>
  <x:Double x:Key="DuiTypographySectionTitle">16</x:Double>
  <x:Double x:Key="DuiTypographySubtitle">14</x:Double>
  <x:Double x:Key="DuiTypographyBodySmall">12</x:Double>
  <x:Double x:Key="DuiTypographyNavigation">13</x:Double>
  <x:Double x:Key="DuiPagePadding">24</x:Double>
  <x:Double x:Key="DuiSectionGap">24</x:Double>
  <x:Double x:Key="DuiCardGap">12</x:Double>
  <x:Double x:Key="DuiCardPadding">16</x:Double>
  <x:Double x:Key="DuiShellRegionPadding">16</x:Double>
  <Thickness x:Key="DuiShellRegionPaddingThickness">16</Thickness>
  <Thickness x:Key="DuiShellHeaderPadding">16,12</Thickness>
  <Thickness x:Key="DuiShellStatusPadding">16,8</Thickness>
  <CornerRadius x:Key="DuiRadiusMediumCorner">7</CornerRadius>
  <x:Double x:Key="DuiNavigationRowHeight">34</x:Double>
  <x:Double x:Key="DuiNavigationIndent">14</x:Double>
  <Thickness x:Key="DuiNavigationOverflowMargin">14,1,0,1</Thickness>
  <x:Double x:Key="DuiNavigationChevronSize">12</x:Double>
  <x:Double x:Key="DuiNavigationIconSize">16</x:Double>
  <x:Double x:Key="DuiStrokeSubtle">1</x:Double>
  <!-- Universal Editor: semantic theme mappings. 11F may author these without changing editor anatomy. -->
  <x:Double x:Key="DuiEditorControlHeight">32</x:Double>
  <x:Double x:Key="DuiEditorContentPadding">10</x:Double>
  <Thickness x:Key="DuiEditorContentPaddingValue">10,0</Thickness>
  <x:Double x:Key="DuiEditorInlineGap">8</x:Double>
  <x:Double x:Key="DuiEditorHelpGap">4</x:Double>
  <x:Double x:Key="DuiEditorIconSize">16</x:Double>
  <x:Double x:Key="DuiEditorLeadingSlotWidth">28</x:Double>
  <x:Double x:Key="DuiEditorTrailingSlotWidth">28</x:Double>
  <x:Double x:Key="DuiEditorBorderThickness">1</x:Double>
  <x:Double x:Key="DuiEditorRadius">6</x:Double>
  <Thickness x:Key="DuiEditorBorderThicknessValue">1</Thickness>
  <CornerRadius x:Key="DuiEditorRadiusValue">6</CornerRadius>
  <x:Double x:Key="DuiEditorWidthTime">140</x:Double>
  <x:Double x:Key="DuiEditorWidthDateTime">368</x:Double>
  <x:Double x:Key="DuiEditorWidthDateRange">460</x:Double>
  <x:Double x:Key="DuiPopupMaxHeight">240</x:Double>
  <x:Double x:Key="DuiPopupPadding">8</x:Double>
  <x:Double x:Key="DuiPopupOptionHeight">32</x:Double>
  <!-- Actipro ModernTheme CheckBox chrome has a 20px physical minimum. -->
  <x:Double x:Key="DuiMultiChoiceCheckSize">20</x:Double>
  <x:Double x:Key="DuiCheckBoxSize">20</x:Double>
  <x:Double x:Key="DuiCheckBoxIconSize">14</x:Double>
  <Thickness x:Key="DuiCheckBoxBorderThickness">1</Thickness>
  <CornerRadius x:Key="DuiCheckBoxRadius">4</CornerRadius>
  <x:Double x:Key="DuiMultiChoiceOptionGap">8</x:Double>
  <x:Double x:Key="DuiPopupBorderThickness">1</x:Double>
  <x:Double x:Key="DuiPopupRadius">6</x:Double>
  <x:String x:Key="DuiPopupElevation">0 1 2 0 #0F10281A</x:String>
  <ControlTheme x:Key="DuiCheckBoxTheme" TargetType="CheckBox">
    <Setter Property="Width" Value="{DynamicResource DuiCheckBoxSize}" />
    <Setter Property="Height" Value="{DynamicResource DuiCheckBoxSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border x:Name="BoxSurface"
                  Background="{DynamicResource DuiCheckBoxBackgroundBrush}"
                  BorderBrush="{DynamicResource DuiCheckBoxBorderBrush}"
                  BorderThickness="{DynamicResource DuiCheckBoxBorderThickness}"
                  CornerRadius="{DynamicResource DuiCheckBoxRadius}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
              <local:SemanticIcon x:Name="CheckIcon" SemanticKey="CHECK" IsVisible="False"
                                  Width="{DynamicResource DuiCheckBoxIconSize}"
                                  Height="{DynamicResource DuiCheckBoxIconSize}"
                                  Foreground="{DynamicResource DuiCheckBoxIconBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
              <local:SemanticIcon x:Name="IndeterminateIcon" SemanticKey="INDETERMINATE" IsVisible="False"
                                  Width="{DynamicResource DuiCheckBoxIconSize}"
                                  Height="{DynamicResource DuiCheckBoxIconSize}"
                                  Foreground="{DynamicResource DuiCheckBoxIconBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#BoxSurface">
      <Setter Property="Background" Value="{DynamicResource DuiCheckBoxHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DuiCheckBoxHoverBorderBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Border#BoxSurface">
      <Setter Property="Background" Value="{DynamicResource DuiCheckBoxCheckedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DuiCheckBoxCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:checked /template/ local|SemanticIcon#CheckIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#BoxSurface">
      <Setter Property="Background" Value="{DynamicResource DuiCheckBoxCheckedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DuiCheckBoxCheckedBorderBrush}" />
    </Style>
    <Style Selector="^:indeterminate /template/ local|SemanticIcon#IndeterminateIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus /template/ Border#BoxSurface">
      <Setter Property="BorderBrush" Value="{DynamicResource DuiCheckBoxFocusBorderBrush}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#BoxSurface">
      <Setter Property="Background" Value="{DynamicResource DuiCheckBoxDisabledBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DuiCheckBoxDisabledBorderBrush}" />
      <Setter Property="Opacity" Value="0.56" />
    </Style>
  </ControlTheme>
  <x:Double x:Key="DuiDashboardReadableWidth">1180</x:Double>
  <x:Double x:Key="DuiDashboardMetricMinWidth">180</x:Double>
  <x:Double x:Key="DuiMotionNone">0</x:Double>
  <x:Double x:Key="DuiMotionFast">100</x:Double>
  <x:Double x:Key="DuiMotionStandard">160</x:Double>
  <x:Double x:Key="DuiMotionEmphasized">240</x:Double>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
